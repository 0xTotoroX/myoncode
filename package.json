{
  "name": "myoncode",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "build": "tsc -b && vite build --config config/vite.config.ts",
    "lint": "eslint .",
    "type-check": "npm run type-check:app && npm run type-check:functions",
    "type-check:app": "tsc --noEmit -p config/tsconfig.app.json && tsc --noEmit -p config/tsconfig.tooling.json",
    "type-check:functions": "tsc --noEmit -p config/tsconfig.cloudflare-functions.json && tsc --noEmit -p config/tsconfig.supabase-functions.json",
    "mobile:sync": "npm run build && cap sync",
    "mobile:open:ios": "cap open ios",
    "mobile:open:android": "cap open android",
    "test": "vitest run --config config/vite.config.ts",
    "test:changed": "vitest run --config config/vite.config.ts --changed",
    "test:related": "vitest related --run --config config/vite.config.ts",
    "test:database": "bash scripts/check-clinical-workflows.sh",
    "test:watch": "vitest --config config/vite.config.ts",
    "test:coverage": "vitest run --config config/vite.config.ts --coverage",
    "preview": "vite preview --config config/vite.config.ts",
    "build:edgeone": "node --experimental-strip-types config/build-frontend.ts"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@fontsource-variable/material-symbols-outlined": "^5.3.8",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "^2.1.1",
    "html2canvas-pro": "2.5.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.48.0",
    "pdfjs-dist": "6.4.299",
    "radix-ui": "^1.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "threejs-components": "^0.0.30"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.12.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "happy-dom": "^21.0.1",
    "shadcn": "^4.21.3",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "5.0.3",
    "workbox-build": "^7.4.1"
  },
  "license": "AGPL-3.0-only"
}
